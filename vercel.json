{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gym.kevinweaver.dev" }],
      "destination": "https://gym.amicooked.chat/$1",
      "permanent": false
    }
  ]
}

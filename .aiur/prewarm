# aiur warm-base build — referenced from .aiur/config via `prewarm.base_build_file: prewarm`.
# Runs once in a checkout of the target branch at ~/.aiur/repo/<owner>/<name>; aiur then
# materializes each agent workspace from the result via copy-on-write, so every agent
# starts with node_modules already populated instead of paying its own npm install.
#
# npm cache is scoped under the base so the warm cache copies into workspaces too.
mkdir -p ./.aiur-npm-cache
npm_config_cache="$PWD/.aiur-npm-cache" \
  bash -c 'mise exec -- npm ci --no-audit --no-fund || mise exec -- npm install --no-audit --no-fund'

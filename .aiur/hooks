# aiur workspace hooks — referenced from .aiur/config via `hooks_file: hooks`.
#
# Adapted from the aiur repo's own hooks. The git/branch logic and the exit-code
# contract (65 = refuse-refresh, 66 = incomplete reconstruction) are preserved
# verbatim because the Elixir side keys on those codes. Only the toolchain
# warm-up differs: npm instead of mix, and no cache-preservation dance because
# node_modules is gitignored, so git operations never touch it.
timeout_ms: 600000
after_create: |
  set -e
  base_branch="${THIS_BASE_BRANCH:-main}"
  workspace_root="$(pwd -P)"
  git_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_toplevel" ]; then
    git_toplevel="$(CDPATH= cd "$git_toplevel" && pwd -P)"
  fi
  if [ "$git_toplevel" = "$workspace_root" ] &&
     git rev-parse --verify HEAD >/dev/null 2>&1 &&
     git status --porcelain >/dev/null 2>&1; then
    exit 0
  fi
  if [ -n "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "Aiur must stage incomplete workspace reconstruction before after_create runs." >&2
    exit 66
  fi
  git clone "$THIS_REPOSITORY_URL" .
  git fetch origin "$base_branch"
  if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
  else
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
  fi
  if [ -f mise.toml ]; then
    mise trust mise.toml >/dev/null 2>&1 || true
    mise install >/dev/null 2>&1 || true
  fi
  # Warm node_modules so the agent's first command doesn't pay a cold install.
  # Output flows back to Workspace.run_hook via System.cmd (stderr_to_stdout:
  # true) — don't redirect to /dev/null, that masks silent failures. `|| true`
  # keeps this non-fatal: if the install fails now, the agent picks it up on its
  # first npm call, just slower.
  if [ -f package.json ]; then
    bash -c 'mise exec -- npm ci --no-audit --no-fund || mise exec -- npm install --no-audit --no-fund' \
      2>&1 | tail -200 || true
  fi
before_run: |
  set -e
  base_branch="${THIS_BASE_BRANCH:-main}"
  workspace_root="$(pwd -P)"
  git_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_toplevel" ]; then
    git_toplevel="$(CDPATH= cd "$git_toplevel" && pwd -P)"
  fi
  if [ -z "$git_toplevel" ] || [ "$git_toplevel" != "$workspace_root" ] ||
     ! git rev-parse --verify HEAD >/dev/null 2>&1 ||
     ! git status --porcelain >/dev/null 2>&1; then
    if [ -n "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]; then
      echo "Aiur must stage incomplete workspace reconstruction before before_run runs." >&2
      exit 66
    fi
    git clone "$THIS_REPOSITORY_URL" .
    git fetch origin "$base_branch"
    if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
    else
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
    fi
  else
    git fetch origin
    if ! git diff --quiet -- . ':(exclude)logs' ||
       ! git diff --cached --quiet -- . ':(exclude)logs'; then
      # Tracked changes are present. Signal the refusal with exit 65. The Elixir
      # side keys on that status code: a fresh todo dispatch recreates the stale
      # leftover clean; a live/resumed agent's uncommitted WIP is left untouched
      # and the configured-base refresh is skipped non-fatally so the agent keeps
      # working. The text below is Executor-facing only. Do NOT treat this as a
      # hard failure.
      echo "Refusing to refresh workspace from origin/$base_branch because tracked source changes are present." >&2
      echo "Leaving uncommitted work in place; skipping the origin/$base_branch refresh for this run." >&2
      exit 65
    fi
    current_branch="$(git branch --show-current)"
    if [ "$current_branch" != "$AIUR_TICKET_BRANCH" ]; then
      if git show-ref --verify --quiet "refs/heads/$AIUR_TICKET_BRANCH"; then
        git checkout "$AIUR_TICKET_BRANCH"
      elif git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
        git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
      else
        git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
      fi
    fi
    git merge --no-edit "origin/$base_branch"
  fi
  if [ -f mise.toml ]; then
    mise trust mise.toml >/dev/null 2>&1 || true
    mise install >/dev/null 2>&1 || true
  fi
  # Idempotent install on every dispatch. Near-free when node_modules is already
  # warm; pays off on a fresh clone, a resumed workspace, or after a lockfile bump.
  if [ -f package.json ]; then
    bash -c 'mise exec -- npm ci --no-audit --no-fund || mise exec -- npm install --no-audit --no-fund' \
      2>&1 | tail -200 || true
  fi
before_remove: |
  git status --short
